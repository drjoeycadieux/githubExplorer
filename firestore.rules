rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /vulnerabilityReports/{reportId} {
      allow create: if request.resource.data.keys().hasAll([
          'title',
          'affectedAsset',
          'weakness',
          'severity',
          'contactEmail',
          'detailsMarkdown',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'affectedAsset',
          'weakness',
          'severity',
          'contactEmail',
          'detailsMarkdown',
          'status',
          'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 180
        && request.resource.data.affectedAsset is string
        && request.resource.data.affectedAsset.size() >= 1
        && request.resource.data.affectedAsset.size() <= 500
        && request.resource.data.weakness in [
          'Broken access control',
          'Cross-site scripting (XSS)',
          'Injection',
          'Security misconfiguration',
          'Sensitive data exposure',
          'Server-side request forgery (SSRF)',
          'Denial of service',
          'Cryptographic issue',
          'Other'
        ]
        && request.resource.data.severity in [
          'critical',
          'high',
          'medium',
          'low',
          'informational'
        ]
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 320
        && request.resource.data.contactEmail.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && request.resource.data.detailsMarkdown is string
        && request.resource.data.detailsMarkdown.size() >= 40
        && request.resource.data.detailsMarkdown.size() <= 40000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
